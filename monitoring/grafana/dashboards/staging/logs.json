{
  "title": "Logs — Staging",
  "uid": "rmit-logs-staging",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {"from": "now-15m", "to": "now"},
  "templating": {
    "list": [
      {
        "name": "container",
        "type": "query",
        "label": "Container",
        "datasource": {"type": "loki", "uid": "loki"},
        "query": "label_values({env=\"staging\"}, container)",
        "regex": "/^rmit.*/",
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "logs",
      "title": "Container logs — env=staging",
      "gridPos": {"h": 20, "w": 24, "x": 0, "y": 0},
      "targets": [
        {
          "datasource": {"type": "loki", "uid": "loki"},
          "expr": "{env=\"staging\", container=\"$container\"}",
          "refId": "A"
        }
      ],
      "options": {"showTime": true, "wrapLogMessage": true, "sortOrder": "Descending"}
    }
  ]
}
