{
  "title": "Logs — Staging",
  "uid": "rmit-logs-staging",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {"from": "now-15m", "to": "now"},
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "custom",
        "label": "Service",
        "query": "backend, frontend, db",
        "current": {"selected": true, "text": "All", "value": "$__all"},
        "options": [
          {"selected": true, "text": "All", "value": "$__all"},
          {"selected": false, "text": "backend", "value": "backend"},
          {"selected": false, "text": "frontend", "value": "frontend"},
          {"selected": false, "text": "db", "value": "db"}
        ],
        "includeAll": true,
        "multi": true
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "logs",
      "title": "App container logs (backend / frontend / db) — env=staging",
      "gridPos": {"h": 20, "w": 24, "x": 0, "y": 0},
      "targets": [
        {
          "datasource": {"type": "loki", "uid": "loki"},
          "expr": "{env=\"staging\", compose_service=~\"$service\"}",
          "refId": "A"
        }
      ],
      "options": {"showTime": true, "wrapLogMessage": true, "sortOrder": "Descending"}
    }
  ]
}
