/*
RMIT University Vietnam
Course: COSC2767/COSC2805 Systems Deployment and Operations
Semester: 2026B
Assessment: Assignment 2
Acknowledgement: Jenkins documentation, Ansible documentation.

Staging provisioning pipeline. Reads the target host(s) from
ansible/inventories/staging.ini — no IP inputs on the Jenkins UI.

To add or replace a staging EC2:
  1. Edit ansible/inventories/staging.ini and update the [staging] group's
     ansible_host= line to the new EC2's private IP (Jenkins is inside the
     VPC and connects via private).
  2. git commit + push.
  3. GitHub webhook triggers this pipeline. It is idempotent — safe to run
     against an already-provisioned host.

Playbooks executed (all against the [staging] group):
  - setup-hosts.yml           Docker + Compose plugin + workspace dir
  - init-swarm.yml            Single-node Docker Swarm (staging IS its own
                              manager; advertise_addr defaults to ansible_host)
  - monitoring.yml            role=exporters — node_exporter + promtail shipping
                              to the CENTRAL Grafana/Loki on the prod manager.
                              (See Step 4 of the refactor: central stack lives on
                              prod manager, staging only runs exporters.)
*/

pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
        timeout(time: 20, unit: 'MINUTES')
    }


    environment {
        ANSIBLE_NOCOLOR = '1'
        ANSIBLE_HOST_KEY_CHECKING = 'False'
    }

    stages {

        stage('Checkout') {
            steps {
                deleteDir()
                checkout scm
            }
        }

        stage('Verify SSH to Staging Host(s)') {
            steps {
                withCredentials([
                    sshUserPrivateKey(
                        credentialsId: 'staging-ec2-ssh-key',
                        keyFileVariable: 'SSH_KEY',
                        usernameVariable: 'SSH_USER'
                    )
                ]) {
                    sh '''
                        set -eu
                        export ANSIBLE_CONFIG="${WORKSPACE}/ansible/ansible.cfg"
                        ansible staging \
                            --inventory ansible/inventories/staging.ini \
                            --module-name ping \
                            --user "${SSH_USER}" \
                            --private-key "${SSH_KEY}"
                    '''
                }
            }
        }

        stage('Setup Host (Docker + Compose)') {
            steps {
                withCredentials([
                    sshUserPrivateKey(
                        credentialsId: 'staging-ec2-ssh-key',
                        keyFileVariable: 'SSH_KEY',
                        usernameVariable: 'SSH_USER'
                    )
                ]) {
                    sh '''
                        set -euo pipefail
                        export ANSIBLE_CONFIG="${WORKSPACE}/ansible/ansible.cfg"
                        ansible-playbook \
                            --inventory ansible/inventories/staging.ini \
                            --limit staging \
                            --user "${SSH_USER}" \
                            --private-key "${SSH_KEY}" \
                            ansible/setup-hosts.yml
                    '''
                }
            }
        }

        stage('Init Single-Node Swarm') {
            steps {
                withCredentials([
                    sshUserPrivateKey(
                        credentialsId: 'staging-ec2-ssh-key',
                        keyFileVariable: 'SSH_KEY',
                        usernameVariable: 'SSH_USER'
                    )
                ]) {
                    sh '''
                        set -euo pipefail
                        export ANSIBLE_CONFIG="${WORKSPACE}/ansible/ansible.cfg"
                        # target_hosts overrides the playbook's default group
                        # (swarm_manager) so init-swarm runs against [staging].
                        # advertise_addr defaults to ansible_host (private IP).
                        ansible-playbook \
                            --inventory ansible/inventories/staging.ini \
                            --limit staging \
                            --user "${SSH_USER}" \
                            --private-key "${SSH_KEY}" \
                            -e target_hosts=staging \
                            ansible/init-swarm.yml
                    '''
                }
            }
        }

        stage('Fetch Prod Manager IP (Loki target)') {
            steps {
                script {
                    // Staging's promtail ships logs to Loki, which runs on
                    // the prod swarm manager. Read that IP from prod.ini so
                    // this pipeline has no hardcoded coupling to prod.
                    env.MANAGER_PRIVATE_IP = sh(
                        returnStdout: true,
                        script: '''
                            ansible-inventory \
                                -i ansible/inventories/prod.ini \
                                --list \
                            | python3 -c "
import json, sys
d = json.load(sys.stdin)
name = d['swarm_manager']['hosts'][0]
print(d['_meta']['hostvars'][name]['ansible_host'])
"
                        '''
                    ).trim()
                    if (!env.MANAGER_PRIVATE_IP) {
                        error "Could not resolve swarm_manager ansible_host from ansible/inventories/prod.ini"
                    }
                    echo "Prod manager private IP (for promtail): ${env.MANAGER_PRIVATE_IP}"
                }
            }
        }

        stage('Deploy Monitoring Exporters') {
            steps {
                withCredentials([
                    sshUserPrivateKey(
                        credentialsId: 'staging-ec2-ssh-key',
                        keyFileVariable: 'SSH_KEY',
                        usernameVariable: 'SSH_USER'
                    )
                ]) {
                    sh '''
                        set -euo pipefail
                        export ANSIBLE_CONFIG="${WORKSPACE}/ansible/ansible.cfg"
                        # Staging runs only node_exporter + promtail. Loki
                        # (log ingest) + Prometheus (metrics scrape) live on
                        # the prod swarm manager. Grafana runs separately on
                        # its own dedicated EC2 and queries prod-manager
                        # Prometheus + Loki to visualise everything.
                        # MANAGER_PRIVATE_IP was resolved from prod.ini.
                        ansible-playbook \
                            --inventory ansible/inventories/staging.ini \
                            --limit staging \
                            --user "${SSH_USER}" \
                            --private-key "${SSH_KEY}" \
                            -e target_hosts=staging \
                            -e role=exporters \
                            -e env=staging \
                            -e manager_private_ip=${MANAGER_PRIVATE_IP} \
                            ansible/monitoring.yml
                    '''
                }
            }
        }

        stage('Report') {
            steps {
                script {
                    def summary = """
Staging provisioning complete — targets from ansible/inventories/staging.ini
  - Docker + Compose v2 installed
  - Docker Swarm active (single-node)
  - Monitoring exporters running (node_exporter + promtail)
  - Logs shipping to Loki on prod manager (${env.MANAGER_PRIVATE_IP}:3100)
  - Metrics scraped by Prometheus on prod manager (${env.MANAGER_PRIVATE_IP}:9090)

View in Grafana (dedicated observability EC2): http://<grafana-public-ip>:3000

Next: push a commit to trigger the main deploy pipeline. It will deploy the
app to whatever host is currently in [staging].
"""
                    echo summary
                    writeFile file: 'reports/provision-staging-summary.txt', text: summary
                    archiveArtifacts artifacts: 'reports/provision-staging-summary.txt', fingerprint: true
                }
            }
        }
    }

    post {
        success {
            echo "Staging provisioning complete."
        }
        failure {
            echo "Staging provisioning FAILED. Inspect the failed stage log. Re-run is safe (playbooks are idempotent)."
        }
    }
}
