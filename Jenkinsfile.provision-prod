/*
RMIT University Vietnam
Course: COSC2767/COSC2805 Systems Deployment and Operations
Semester: 2026B
Assessment: Assignment 2
Acknowledgement: Jenkins documentation, Ansible documentation, Docker Swarm
documentation.

Production provisioning pipeline. Reads the target fleet from
ansible/inventories/prod.ini — no IP inputs on the Jenkins UI.

Inventory groups consumed:
  [swarm_manager]  one host (the swarm manager)
  [swarm_workers]  N hosts (workers; can add/remove)
  [production]     union of the two

Adding a new worker:
  1. Edit ansible/inventories/prod.ini and append the worker under
     [swarm_workers]. Use its private IP for ansible_host.
  2. git commit + push.
  3. GitHub webhook triggers this pipeline. Already-provisioned hosts are
     skipped (idempotent playbooks); the new worker joins the swarm and
     starts the exporter stack. The central monitoring config on the
     manager is re-rendered with the new worker included, so Prometheus
     starts scraping it within one scrape interval.

Ordering matters:
  1. Setup Docker + Compose on ALL hosts.
  2. Init swarm on the manager (idempotent).
  3. Fetch worker join token from the manager.
  4. For each worker: join swarm + install exporters (both idempotent).
  5. Re-render central monitoring on the manager LAST — this way the new
     scrape config includes the current [swarm_workers] set.
  6. Verify fleet has N+1 nodes.
*/

pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
        timeout(time: 30, unit: 'MINUTES')
    }

    triggers {
        githubPush()
    }

    environment {
        ANSIBLE_NOCOLOR = '1'
        ANSIBLE_HOST_KEY_CHECKING = 'False'
    }

    stages {

        stage('Checkout') {
            steps {
                deleteDir()
                checkout scm
            }
        }

        stage('Verify SSH to Fleet') {
            steps {
                withCredentials([
                    sshUserPrivateKey(
                        credentialsId: 'staging-ec2-ssh-key',
                        keyFileVariable: 'SSH_KEY',
                        usernameVariable: 'SSH_USER'
                    )
                ]) {
                    sh '''
                        set -eu
                        export ANSIBLE_CONFIG="${WORKSPACE}/ansible/ansible.cfg"
                        ansible production \
                            --inventory ansible/inventories/prod.ini \
                            --module-name ping \
                            --user "${SSH_USER}" \
                            --private-key "${SSH_KEY}"
                    '''
                }
            }
        }

        stage('Setup Hosts (Docker + Compose on all)') {
            steps {
                withCredentials([
                    sshUserPrivateKey(
                        credentialsId: 'staging-ec2-ssh-key',
                        keyFileVariable: 'SSH_KEY',
                        usernameVariable: 'SSH_USER'
                    )
                ]) {
                    sh '''
                        set -euo pipefail
                        export ANSIBLE_CONFIG="${WORKSPACE}/ansible/ansible.cfg"
                        ansible-playbook \
                            --inventory ansible/inventories/prod.ini \
                            --limit production \
                            --user "${SSH_USER}" \
                            --private-key "${SSH_KEY}" \
                            ansible/setup-hosts.yml
                    '''
                }
            }
        }

        stage('Init Swarm on Manager') {
            steps {
                withCredentials([
                    sshUserPrivateKey(
                        credentialsId: 'staging-ec2-ssh-key',
                        keyFileVariable: 'SSH_KEY',
                        usernameVariable: 'SSH_USER'
                    )
                ]) {
                    sh '''
                        set -euo pipefail
                        export ANSIBLE_CONFIG="${WORKSPACE}/ansible/ansible.cfg"
                        # target_hosts default is already swarm_manager, but pass
                        # it explicitly to make the intent obvious.
                        # advertise_addr defaults to ansible_host (private IP).
                        ansible-playbook \
                            --inventory ansible/inventories/prod.ini \
                            --limit swarm_manager \
                            --user "${SSH_USER}" \
                            --private-key "${SSH_KEY}" \
                            -e target_hosts=swarm_manager \
                            ansible/init-swarm.yml
                    '''
                }
            }
        }

        stage('Fetch Manager IP + Join Token') {
            steps {
                withCredentials([
                    sshUserPrivateKey(
                        credentialsId: 'staging-ec2-ssh-key',
                        keyFileVariable: 'SSH_KEY',
                        usernameVariable: 'SSH_USER'
                    )
                ]) {
                    script {
                        // Read manager's private IP straight from inventory —
                        // single source of truth, no coupling to hardcoded env
                        // vars in the pipeline.
                        env.MANAGER_PRIVATE_IP = sh(
                            returnStdout: true,
                            script: '''
                                ansible-inventory \
                                    -i ansible/inventories/prod.ini \
                                    --list \
                                | python3 -c "
import json, sys
d = json.load(sys.stdin)
name = d['swarm_manager']['hosts'][0]
print(d['_meta']['hostvars'][name]['ansible_host'])
"
                            '''
                        ).trim()
                        echo "Manager private IP: ${env.MANAGER_PRIVATE_IP}"

                        // SSH to manager (via its ansible_host — Jenkins is
                        // inside the VPC and reaches private IPs).
                        env.WORKER_JOIN_TOKEN = sh(
                            returnStdout: true,
                            script: '''
                                ssh -o StrictHostKeyChecking=no \
                                    -i "${SSH_KEY}" \
                                    "${SSH_USER}@${MANAGER_PRIVATE_IP}" \
                                    'sudo docker swarm join-token worker -q'
                            '''
                        ).trim()
                        if (!env.WORKER_JOIN_TOKEN) {
                            error "Empty join token - is the manager initialised?"
                        }
                        echo "Fetched worker join token (${env.WORKER_JOIN_TOKEN.length()} chars)."
                    }
                }
            }
        }

        stage('Join Workers to Swarm') {
            steps {
                withCredentials([
                    sshUserPrivateKey(
                        credentialsId: 'staging-ec2-ssh-key',
                        keyFileVariable: 'SSH_KEY',
                        usernameVariable: 'SSH_USER'
                    )
                ]) {
                    sh '''
                        set -euo pipefail
                        export ANSIBLE_CONFIG="${WORKSPACE}/ansible/ansible.cfg"
                        # Ansible runs the playbook against EACH host in
                        # [swarm_workers]. join-swarm.yml is idempotent —
                        # already-joined workers are skipped.
                        ansible-playbook \
                            --inventory ansible/inventories/prod.ini \
                            --limit swarm_workers \
                            --user "${SSH_USER}" \
                            --private-key "${SSH_KEY}" \
                            -e target_hosts=swarm_workers \
                            -e manager_private_ip=${MANAGER_PRIVATE_IP} \
                            -e join_token=${WORKER_JOIN_TOKEN} \
                            ansible/join-swarm.yml
                    '''
                }
            }
        }

        stage('Deploy Exporters on All Workers') {
            steps {
                withCredentials([
                    sshUserPrivateKey(
                        credentialsId: 'staging-ec2-ssh-key',
                        keyFileVariable: 'SSH_KEY',
                        usernameVariable: 'SSH_USER'
                    )
                ]) {
                    sh '''
                        set -euo pipefail
                        export ANSIBLE_CONFIG="${WORKSPACE}/ansible/ansible.cfg"
                        # role=exporters installs node_exporter + promtail on
                        # each worker; promtail's clients.url is rendered with
                        # the manager's private IP so logs flow to central Loki.
                        ansible-playbook \
                            --inventory ansible/inventories/prod.ini \
                            --limit swarm_workers \
                            --user "${SSH_USER}" \
                            --private-key "${SSH_KEY}" \
                            -e target_hosts=swarm_workers \
                            -e role=exporters \
                            -e env=prod \
                            -e manager_private_ip=${MANAGER_PRIVATE_IP} \
                            ansible/monitoring.yml
                    '''
                }
            }
        }

        stage('Deploy Central Monitoring on Manager') {
            steps {
                withCredentials([
                    sshUserPrivateKey(
                        credentialsId: 'staging-ec2-ssh-key',
                        keyFileVariable: 'SSH_KEY',
                        usernameVariable: 'SSH_USER'
                    )
                ]) {
                    sh '''
                        set -euo pipefail
                        export ANSIBLE_CONFIG="${WORKSPACE}/ansible/ansible.cfg"
                        # Both inventories are passed so prometheus.yml.j2 can
                        # iterate groups['swarm_workers'] AND groups['staging']
                        # — the central Prometheus scrapes both envs.
                        # --force-recreate on the compose up (in the playbook)
                        # makes Prometheus pick up new scrape config on every run.
                        ansible-playbook \
                            --inventory ansible/inventories/prod.ini \
                            --inventory ansible/inventories/staging.ini \
                            --limit swarm_manager \
                            --user "${SSH_USER}" \
                            --private-key "${SSH_KEY}" \
                            -e target_hosts=swarm_manager \
                            -e role=central \
                            -e env=prod \
                            ansible/monitoring.yml
                    '''
                }
            }
        }

        stage('Verify Fleet') {
            steps {
                withCredentials([
                    sshUserPrivateKey(
                        credentialsId: 'staging-ec2-ssh-key',
                        keyFileVariable: 'SSH_KEY',
                        usernameVariable: 'SSH_USER'
                    )
                ]) {
                    sh '''
                        set -euo pipefail
                        NODES=$(ssh -o StrictHostKeyChecking=no \
                                    -i "${SSH_KEY}" \
                                    "${SSH_USER}@${MANAGER_PRIVATE_IP}" \
                                    'sudo docker node ls')
                        echo "$NODES"
                        COUNT=$(echo "$NODES" | tail -n +2 | wc -l)
                        EXPECTED=$(ansible-inventory -i ansible/inventories/prod.ini --list \
                                   | python3 -c "
import json, sys
d = json.load(sys.stdin)
print(len(d['production']['children']))" 2>/dev/null || true)
                        # Fallback: count all production hosts directly.
                        if [ -z "${EXPECTED}" ] || [ "${EXPECTED}" = "0" ]; then
                            EXPECTED=$(ansible-inventory -i ansible/inventories/prod.ini --list \
                                       | python3 -c "
import json, sys
d = json.load(sys.stdin)
print(len(d['production']['hosts']))")
                        fi
                        # 'production' as a group of children (swarm_manager +
                        # swarm_workers) so real count is total hosts across
                        # those subgroups.
                        MGR=$(ansible-inventory -i ansible/inventories/prod.ini --list \
                              | python3 -c "
import json, sys
d = json.load(sys.stdin)
print(len(d['swarm_manager']['hosts']))")
                        WRK=$(ansible-inventory -i ansible/inventories/prod.ini --list \
                              | python3 -c "
import json, sys
d = json.load(sys.stdin)
print(len(d['swarm_workers']['hosts']))")
                        EXPECTED=$((MGR + WRK))
                        echo "Nodes in swarm: ${COUNT}   Expected (manager + workers): ${EXPECTED}"
                        if [ "${COUNT}" -lt "${EXPECTED}" ]; then
                            echo "Fleet incomplete."
                            exit 1
                        fi
                        echo "Fleet OK."
                    '''
                }
            }
        }

        stage('Report') {
            steps {
                script {
                    def summary = """
Prod fleet provisioning complete — targets from ansible/inventories/prod.ini
  - Docker + Compose v2 installed on all hosts
  - Swarm active (manager + workers)
  - Central monitoring stack on manager (Prometheus + Grafana + Loki)
  - Exporters (node_exporter + promtail) on every worker, shipping to manager

Central Grafana:    http://<manager-public-ip>:3000  (admin / RmitMonitor2767!)
Central Prometheus: http://<manager-public-ip>:9090

Adding another worker later: append to [swarm_workers] in
ansible/inventories/prod.ini, commit, push. This pipeline runs again and:
  - Skips already-joined workers
  - Joins the new one + installs exporters
  - Re-renders Prometheus scrape config on the manager to include it
"""
                    echo summary
                    writeFile file: 'reports/provision-prod-summary.txt', text: summary
                    archiveArtifacts artifacts: 'reports/provision-prod-summary.txt', fingerprint: true
                }
            }
        }
    }

    post {
        success {
            echo "Prod fleet provisioning complete."
        }
        failure {
            echo "Prod fleet provisioning FAILED. Inspect the failed stage log. Re-run is safe (playbooks are idempotent)."
        }
    }
}
